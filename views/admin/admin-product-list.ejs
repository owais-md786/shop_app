<%- include('../includes/head.ejs') %>  

    <link rel="stylesheet" href="/css/navigation.css">
    <link rel="stylesheet" href="/css/user-view.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main class="content">
        <% if(prodss.length>0) { %>
            <h1>My Products</h1>
            <p id="list">List of all the products</p>

            <div class="prods">

                <% for(let product of prodss) {%>

                    <div class="prod">
                        <div class="item">
                            <div class="img">
                                <img class="prod-img" src="/images/<%= product.imageURL %>" alt="<%=product.title.charAt(0).toUpperCase()+product.title.substring(1)%>">
                            </div>
                            <div class="title">
                                <p id="title-name">
                                    <%=product.title.charAt(0).toUpperCase()+product.title.substring(1)%>
                                </p>
                            </div>
                            <div class="price">
                                <div class="innerp">
                                    <span>Price: </span>
                                    <p>

                                        ₹<%= product.formattedprice%>
                                    </p>

                                </div>
                            </div>
                            <div class="desc">
                        <p class="description"><%= product.description%></p>
                    </div>
                            <div class="action-btn">
                        <a href="/admin/edit-product/<%= product._id %>?edit=true" class="edit-btn">Edit</a>
                        
                       
                             <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="delete-btn" type="button">Delete</button>
                            <input type="hidden" name="productId" value="<%= product._id %>">
                        
                    </div>
                        </div>

                    </div>
                <%}%>

            </div>

            <%} else {%>
                <h1>No Products</h1>
                <%}%>
    </main>
<%- include('../includes/end.ejs') %>
<script src="/javascript/admin.js"></script>