<%- include('../includes/head.ejs') %>

    <link rel="stylesheet" href="/css/navigation.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Signika:wght@300..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap');
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main class="main">

                <div class="signin">
                    <h1>Admin Log in</h1>
                    <form class="login-form" action="/admin/login" method="POST">

                        <div class="email-input">
                            <input type="email" name="myemail" id="email" pattern="[A-Za-z0-9@._\-!#$%^&*()+=]*"
                                placeholder="Email">

                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="inputpass">
                            <input type="password" name="mypassword" id="pass" minlength="6" maxlength="8"
                                placeholder="Password">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <div class="forgotpass">
                            <a href="/reset-password" id="forp">Forgot password?</a>
                        </div>

                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" id="submit">Log in</button>



                    </form>

                </div>
                <% if(errorMessage) { %>
                    <div class="error-msg">
                        <p id="msg">
                            <%= errorMessage %>
                        </p>
                    </div>
                    <% } %>
            </main>

    </body>

    </html>