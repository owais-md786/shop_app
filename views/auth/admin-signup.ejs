<%- include('../includes/head.ejs') %>

    <link rel="stylesheet" href="/css/navigation.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Signika:wght@300..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap');
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main class="main">
                <% if(errorMessage) { %>
                    <div class="error-msg">
                        <p id="msg">
                            <%= errorMessage %>
                        </p>
                    </div>
                <% } %>

                        <div class="signin">
                            <h1>Admin Sign Up</h1>
                            <form class="login-form" action="/admin/signup" method="POST">

                                <div class="email-input">
                                    <input type="email" name="myemail" id="email" pattern="[A-Za-z0-9@._\-!#$%^&*()+=]*"
                                        placeholder="Email">

                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <div class="phone-input">
                                    <input type="tel" name="myphone" id="phone" placeholder="Phone Number">

                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <div class="username-input">
                                    <input type="text" name="myusername" id="username"
                                        pattern="[A-Za-z0-9@._\-!#$%^&*()+=]*" placeholder="Username">

                                    <i class="fa-solid fa-user"></i>
                                </div>
                                
                                <div class="inputpass">
                                    <input type="password" name="mypassword" id="pass" minlength="6" maxlength="8"
                                        placeholder="Password">
                                    <i class="fa-solid fa-lock"></i>
                                </div>
                                <div class="inputpass">
                                    <input type="password" name="myconfirmpassword" id="pass" minlength="6"
                                        maxlength="8" placeholder="Confirm Password">
                                    <i class="fa-solid fa-lock"></i>
                                </div>

                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" id="submit">Signup</button>



                            </form>
                        </div>

            </main>

    </body>

    </html>