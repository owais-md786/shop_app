<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= pageTitle%> Detail
    </title>

    <link rel="stylesheet" href="/css/product-detail.css">
    <link rel="stylesheet" href="/css/navigation.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

        <main id="detail">
            <div class="product">
                <div class="main">
                    <h1 class="title">
                        <%=product.title.charAt(0).toUpperCase()+product.title.substring(1)%>
                    </h1>
                </div>
                <div class="line"></div>
                <div class="img">
                    <img src="/images/<%= product.imageURL %>" alt="<%= product.title %>">
                </div>
                <div class="rate">
                    <h3 class="price">₹<%= currencyINR(product.price)%></h3>
                </div>

                <div class="desc">
                    <p class="description">
                        <%= product.description %>
                    </p>
                </div>
                <div class="btn">
                    <%if(isAuthenticatedUser && !isAuthenticatedAdmin) {%>
                                    
                        <%- include('../includes/add-to-cart.ejs') %>
                <%}%>
                </div>

            </div>


        </main>

        <%- include('../includes/end.ejs') %>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/javascript/socket.js"></script>
        <script src="/javascript/addToCartFromDetails.js"></script>
               